{
  "name": "lmr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio LMR y demo publica en Cloudflare Workers Static Assets.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/prepare-lmr-demo.mjs",
    "package:demo": "node scripts/prepare-lmr-demo.mjs && python scripts/package-lmr-demo.py",
    "preview": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check scripts/build.mjs && node --check scripts/prepare-lmr-demo.mjs && node --check scripts/serve.mjs && node scripts/validate-content.mjs",
    "deploy:demo": "npx --yes wrangler@4.156.1 deploy --config deploy/lmr-demo/wrangler.jsonc"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
